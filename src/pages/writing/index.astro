---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/writing/PostList.astro';
import { getPosts } from '../../lib/content';
import { url } from '../../lib/url';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<BaseLayout title="Writing" description="Explainers on math and machine learning.">
	<article class="paper">
		<h1>Writing</h1>
		<p class="prose">
			Explainers on math and machine learning: the things I wish someone had told me
			when I was learning them. Subscribe with <a href={url('/rss.xml')}>RSS</a>.
		</p>
		{
			posts.length === 0 ? (
				<PostList posts={[]} />
			) : (
				years.map((year) => (
					<section>
						<h2 class="label year">{year}</h2>
						<PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === year)} />
					</section>
				))
			)
		}
	</article>
</BaseLayout>

<style>
	.year {
		margin: 2rem 0 0.5rem;
		font-size: 0.8rem;
	}
</style>
