---
import { getSite } from '../../lib/content';
import { url } from '../../lib/url';
import ViewSource from './ViewSource.astro';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>© {year} {site.name}</span>
	<span aria-hidden="true">·</span>
	<a href={url('/rss.xml')}>rss</a>
	<span aria-hidden="true">·</span>
	<a href="https://github.com/Kaleab-A/last-personal-website">source</a>
	<span aria-hidden="true">·</span>
	<ViewSource />
	<span aria-hidden="true">·</span>
	<span class="muted">no cookies, no trackers</span>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.6rem;
		padding: 0.75rem var(--gutter);
		border-top: var(--line);
		background: var(--paper);
		font-family: var(--mono);
		font-size: 0.75rem;
	}
	/* keep the footer clear of the fixed radio */
	@media (min-width: 640px) {
		.site-footer {
			padding-right: 21rem;
		}
	}
	@media (max-width: 639px) {
		.site-footer {
			padding-bottom: 5.5rem;
		}
	}
</style>
