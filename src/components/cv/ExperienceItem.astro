---
import type { Experience } from '../../lib/content';
import { dateRange } from '../../lib/dates';
import Logo from '../ui/Logo.astro';

interface Props {
	entry: Experience;
}
const { data } = Astro.props.entry;
// One range, or several (newest first) for a role held more than once.
const periods = data.periods ?? [{ start: data.start, end: data.end }];
const dates =
	periods
		.map((p) => dateRange(p.start, p.end))
		.filter(Boolean)
		.reverse()
		.join(' · ') || null;
---

<article class="xp">
	<div class="xp__head">
		<h3>
			<strong>{data.role}</strong>,{' '}
			<span class="xp__org">
				{data.logo && <Logo src={data.logo} />}
				{data.url ? <a href={data.url}>{data.org}</a> : data.org}
			</span>
			{data.draft && <span class="label xp__draft">draft</span>}
		</h3>
		{dates && <p class="mono xp__dates">{dates}</p>}
	</div>
	{data.location && <p class="muted xp__loc">{data.location}</p>}
	{
		data.bullets.length > 0 && (
			<ul>
				{data.bullets.map((b) => (
					<li>{b}</li>
				))}
			</ul>
		)
	}
</article>

<style>
	.xp {
		margin-bottom: 1.4rem;
	}
	.xp__head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0 1rem;
	}
	h3 {
		margin: 0;
		font-size: 1.1rem;
	}
	.xp__org {
		white-space: nowrap;
	}
	.xp__org :global(.logo) {
		margin-right: 0.3em;
	}
	.xp__dates {
		margin: 0;
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.xp__loc {
		margin: 0;
		font-size: 0.95rem;
	}
	ul {
		margin: 0.35rem 0 0;
		padding-left: 1.2rem;
		font-size: 1rem;
	}
	.xp__draft {
		margin-left: 0.4rem;
		border: 1px dashed var(--ink);
		padding: 0 0.3rem;
		font-weight: normal;
	}
</style>
